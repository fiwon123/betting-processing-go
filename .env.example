# API
# development or production
ENVIRONMENT=development
API_DB=api
API_DB_USER=api_user
API_DB_PASSWORD=api_password
API_DB_HOST=postgres
API_DB_PORT=5432
API_DB_SSLMODE=disable
API_DB_MIN_CONNS=2
API_DB_MAX_CONNS=10
API_DB_MAX_CONN_LIFETIME=30m
API_DB_MAX_CONN_IDLE_TIME=5m

# Keycloak
KC_DB=keycloak
KC_DB_USER=keycloak_user
KC_DB_PASSWORD=keycloak_password
KC_ADMIN_USERNAME=keycloak_admin
KC_ADMIN_PASSWORD=keycloak_password

# Ministack (for SQS service)
MINISTACK_REGION=us-east-1
AWS_ENDPOINT_URL=http://ministack:4566
SQS_QUEUE_URL=http://ministack:4566/000000000000/local-queue
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test