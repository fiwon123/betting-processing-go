FROM golang:1.26.7-bookworm

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ ./cmd/
COPY internal/ ./internal/
COPY docs/ ./docs/
COPY migrations/ ./migrations/
COPY scripts/ ./scripts/

RUN mkdir -p /app/test-results

CMD ["sh", "-c", "go test -v -race -count=1 -tags='integration e2e' -timeout=300s ./..."]
